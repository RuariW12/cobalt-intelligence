# Copy to .env and fill in. docker compose reads .env automatically.

# Free key from https://fredaccount.stlouisfed.org — covers all macro,
# treasury and credit-spread series.
FRED_API_KEY=

# Host port for the app.
COBALT_PORT=8080

# Model server. Defaults to the ollama service in this compose file.
# If you run ollama natively on the host instead, use:
#   Linux: http://172.17.0.1:11434
#   macOS/Windows: http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:9b
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=30m
